# ─────────────────────────────────────────────────────────────────────────
# Virex — variables de entorno. Copiar a .env.local y completar.
# Todas son de SERVIDOR (ninguna lleva NEXT_PUBLIC_): nunca llegan al navegador.
# ─────────────────────────────────────────────────────────────────────────

# Agente IA. Proveedor intercambiable: "gemini" (por defecto) o "anthropic".
AGENT_PROVIDER=
# Clave del proveedor elegido. La de Gemini (Google AI Studio) tiene que ser de
# un proyecto CON facturación: en la capa gratuita Google usa el contenido para
# mejorar sus productos, y son chats de clientes reales.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Opcional. Por defecto: gemini-3.5-flash-lite (gemini) / claude-haiku-4-5 (anthropic).
AGENT_MODEL=
# Opcional: low | medium | high. Vacío = el default de cada modelo.
AGENT_EFFORT=

# Zernio (WhatsApp + Instagram). La clave empieza con sk_.
ZERNIO_API_KEY=
ZERNIO_PROFILE_ID=
# Cuenta conectada que envía las respuestas (id de Zernio).
ZERNIO_ACCOUNT_ID=
# Secreto que se registra en Zernio al dar de alta el webhook
# (https://<dominio>/api/zernio/webhook). Mínimo 24 caracteres.
ZERNIO_WEBHOOK_SECRET=

# Contraseña del panel (una para todo el equipo) hasta el login con usuarios.
# En producción es obligatoria: sin ella el panel queda cerrado. /reservar y
# el webhook siguen públicos. Cambiarla cierra todas las sesiones abiertas.
PANEL_PASSWORD=

# Demo: "real" desactiva el reloj simulado (por defecto, con el local
# cerrado la demo muestra una tarde de trabajo).
DEMO_CLOCK=

# Base de datos (Supabase → Connect → Direct → Session pooler, tipo URI).
# Con esta variable la app usa la base real; sin ella, la demo en memoria
# (sólo en desarrollo). En producción sin DATABASE_URL la app no arranca,
# salvo que se pida la vidriera a propósito con DATA_SOURCE=demo.
DATABASE_URL=
DATA_SOURCE=
